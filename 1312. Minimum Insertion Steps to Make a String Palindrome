Given a string s. In one step you can insert any character at any index of the string.

Return the minimum number of steps to make s palindrome.

A Palindrome String is one that reads the same backward as well as forward.

..........................................................

class Solution {
public:
    int n;
    int m;
    int solve(int i, int j, string& s, string& rev, vector<vector<int>>& dp) {
        if (i < 0 || j < 0) {
            return 0;
        }
        if (dp[i][j] != -1) {
            return dp[i][j];
        }
        if (s[i] == rev[j]) {
            return dp[i][j] = 1 + solve(i - 1, j - 1, s, rev, dp);
        } else {
            return dp[i][j] = max(solve(i - 1, j, s, rev, dp),
                                  solve(i, j - 1, s, rev, dp));
        }
    }
    int minInsertions(string s) {
        string rev = s;
        reverse(rev.begin(), rev.end());
        n = s.size();
        m = rev.size();
        vector<vector<int>> dp(n + 1, vector<int>(m + 1, 0));
        // int k = solve(n - 1, m - 1, s, rev,dp);
        // return (n - k);

        // Bottom Down Apppoach

        for (int i = 0; i <= n; i++) {
            dp[i][0] = 0;
        }
        for (int j = 0; j <= m; j++) {
            dp[0][j] = 0;
        }
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (s[i - 1] == rev[j - 1]) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                } else {
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }
        // int k = dp[n][m];
        // return (n - k);

        // Space Optmization

        vector<int> prev(n + 1, 0), curr(m + 1, 0);
        

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                if (s[i-1] == rev[j-1]) {
                    curr[j] = 1 + prev[j-1];
                } else {
                    curr[j] = max(prev[j], curr[j-1]);
                }
            }
            prev = curr;
        }

        int k = prev[n];
        return n - k;
    }
};
