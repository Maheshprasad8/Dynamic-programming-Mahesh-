        for (int i = n - 1; i >= 0; i--) {
            dp[i] = stoneValue[i] - dp[i + 1];
            if (i + 2 <= n) {
            dp[i] = max(dp[i], stoneValue[i] + stoneValue[i + 1] -
                               dp[i+2]);
            }
            if (i + 3 <= n) {
            dp[i] =
                max(dp[i], stoneValue[i] + stoneValue[i + 1] + stoneValue[i + 2] -
                             dp[i+3]);
            }
        }
        int diff = dp[0];
        if (diff > 0) {
            return "Alice";
        } else if (diff < 0) {
            return "Bob";
        }
        return "Tie";
    }
