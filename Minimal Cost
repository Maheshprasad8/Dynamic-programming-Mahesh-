Given an array arr[] of size n, where arr[i] denotes the height of ith stone. Geek starts from stone 0 and from stone i, he can jump to stones i + 1, i + 2, … i + k. 
The cost for jumping from stone i to stone j is abs(arr[i] – arr[j]). Find the minimum cost for Geek to reach the last stone.


..........................................................................

class Solution {
  public:
  int solve(int i,vector<int>&arr,int &k,vector<int>&dp){
      int n=arr.size();
      if(i>=n-1){
          return 0; 
      }
      if(dp[i]!=-1){
          return dp[i];
      }
    int minm=INT_MAX;
    for(int j=1;j<=k && (i+j)<n;j++){
        int take=abs(arr[i]-arr[i+j])+solve(i+j,arr,k,dp);
        minm=min(take,minm);
    }
      
    //   int not_take=solve(i+1,arr,k);
      return dp[i]=minm;
  }
  
  int tab(int n,vector<int>&arr,vector<int>&dp,int k){
      dp[0]=0;
     
      for(int i=1;i<n;i++){
           int minm=INT_MAX;
           for(int j=1;j<=k;j++){
               if(i-j>=0){
                  int jump=dp[i-j]+abs(arr[i]-arr[i-j]);
                  minm=min(minm,jump);
                  
               }
           }
           dp[i]=minm;
      }
      return dp[n-1];
  }
    int minimizeCost(int k, vector<int>& arr) {
        
        int n=arr.size();
        vector<int>dp(n+1,-1);
        // return solve(0,arr,k,dp);
     return tab(n,arr,dp,k);   
    }
};

